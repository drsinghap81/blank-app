{
  "name": "trend-desk-desktop",
  "productName": "Trend Desk",
  "version": "1.0.0",
  "private": true,
  "description": "Trend Desk desktop app (Windows / Mac / Linux): an Electron window on the live app.",
  "main": "main.js",
  "author": "Trend Desk",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.trenddesk.desktop",
    "productName": "Trend Desk",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "package.json"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "icon": "build/icon.png", "category": "public.app-category.finance" },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Finance" }
  }
}
