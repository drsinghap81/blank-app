# Copy to config.env (same folder) and edit. Keep secrets (trade password, Telegram token) in the ENVIRONMENT, not here.
MODE=dry                 # dry -> paper -> live
OPEND_HOST=127.0.0.1     # where moomoo OpenD runs
OPEND_PORT=11111
FIRM=FUTUAU              # moomoo Australia
ACC_ID=0                 # 0 = first account; set the US securities account id if you have several (selftest lists them)
CAPITAL_USD=10000        # money given to this system; each of the 10 slots gets (capital + realised P&L) / 10
SLOTS=10
MAX_NEW_PER_DAY=5        # most new buys in one day
MAX_DD_PCT=35            # pause new buys if the book falls this far below its peak (backtest worst ~ -26%)
LIMIT_BUFFER_PCT=0.5     # buy limit = live price + 0.5%
# Live only, set in the environment:  LIVE_CONFIRM=YES_REAL_MONEY   MOOMOO_TRADE_PWD=...
# Optional alerts, environment:       TG_TOKEN=...   TG_CHAT=...
