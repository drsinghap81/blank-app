[Unit]
Description=Top Bottom Angel One bot (one trading day)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
User=bot
WorkingDirectory=/home/bot/blank-app
ExecStart=/home/bot/venv/bin/python tools/angel/run_bot.py
Restart=on-failure
RestartSec=60
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
