# Copy to /opt/trenddesk/.env on the SERVER only (chmod 600). Never commit, never paste into chat.
# --- Angel One SmartAPI (father's account) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# --- app login (make with: python app.py hash  /  python app.py secret) ---
APP_PASSWORD_HASH=
TOKEN_SECRET=
# --- safety ---
LIVE_ORDERS=0            # 0 = dry run (shows the exact order, sends nothing). 1 = real orders after you tap Send + confirm
MAX_ORDER_VALUE=300000   # rupees per order
MAX_ORDERS_DAY=10
# --- sizing ---
CAPITAL=2000000          # capital the system sizes from (0 = Angel's net value)
RISK_PCT=1
MAX_POS_PCT=20
MAX_POSITIONS=10
# --- app ---
ALLOW_ORIGIN=https://drsinghap81.github.io
DATA_DIR=/opt/trenddesk/var
# --- moomoo, read-only (optional; needs OpenD running on this server) ---
MOOMOO_ENABLED=0
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_MARKETS=AU,US
